{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OrbitData",
  "version": "0.1.0",
  "identifier": "com.orbitdata.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OrbitData",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1QjQ3MTIyODI3RTQ3ODAKUldTQVIzNkNJbkcwZFRRNkNVOWNiYWxrRld5bjJUYmdJdTBXWTFnVTV5Y1JhRmNwc3YvNzQrL2EK",
      "endpoints": [
        "https://dl.panpan.space/orbit-data/latest.json",
        "https://github.com/willasn/orbit-data/releases/latest/download/latest.json"
      ]
    }
  }
}
